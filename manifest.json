{
  "manifest_version": 3,
  "name": "Consumption Counter",
  "version": "2.0.0",
  "description": "Quantify and balance your screen time across YouTube, Instagram, TikTok, Reddit, Discord, X, WhatsApp, and 13 social media networks.",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://web.whatsapp.com/*",
    "*://*.tiktok.com/*",
    "*://*.wechat.com/*",
    "*://wx.qq.com/*",
    "*://web.wechat.com/*",
    "*://*.linkedin.com/*",
    "*://web.telegram.org/*",
    "*://*.telegram.org/*",
    "*://*.snapchat.com/*",
    "*://*.reddit.com/*",
    "*://*.x.com/*",
    "*://*.twitter.com/*",
    "*://*.pinterest.com/*",
    "*://*.discord.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://web.whatsapp.com/*",
        "*://*.tiktok.com/*",
        "*://*.wechat.com/*",
        "*://wx.qq.com/*",
        "*://web.wechat.com/*",
        "*://*.linkedin.com/*",
        "*://web.telegram.org/*",
        "*://*.telegram.org/*",
        "*://*.snapchat.com/*",
        "*://*.reddit.com/*",
        "*://*.x.com/*",
        "*://*.twitter.com/*",
        "*://*.pinterest.com/*",
        "*://*.discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Consumption Counter",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "dashboard.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
